JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Self-hosted GitLab (optional; can also be set in Settings -> GitLab)
GITLAB_URL=https://gitlab.example.com
# Personal access token with the "api" scope
GITLAB_TOKEN=

# GitHub (optional; can also be set in Settings -> GitHub). For GitHub Enterprise
# use https://HOST/api/v3 as the URL.
GITHUB_URL=https://api.github.com
# Fine-grained token: Contents and Pull requests read & write. Classic token: repo.
GITHUB_TOKEN=

# AI API keys (optional; can also be set in Settings -> AI providers).
# Copilot CLI is the default and needs no key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
